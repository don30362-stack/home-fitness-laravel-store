# TEMPLATE ONLY. Copy outside the repository; chmod 600 the real runtime file.
# Do not use the example directly. Never publish `docker compose config` output.
# Lowercase GHCR owner and the SAME full 40-character Git SHA for app + web.
GHCR_OWNER=
RELEASE_SHA=
APP_KEY=
HFS_DB_NAME=home_fitness_production
HFS_DB_USER=homefit_app
HFS_DB_PASSWORD=
HFS_DB_ROOT_PASSWORD=
# Create this private directory before starting bootstrap; never commit its contents.
HFS_TLS_DIR=/srv/homefit-store/letsencrypt
# Paths resolve relative to compose.production.yaml. Default is ACME-only.
HFS_NGINX_CONFIG=./deploy/production/nginx/acme-only.conf
# Keep disabled until an independently provisioned zero-permission Demo is verified.
ADMIN_DEMO_ENABLED=false
ADMIN_DEMO_ID=
# APP_URL / secure cookies / SANCTUM are fixed in production Compose.
# Frontend image MUST have been built with VITE_API_BASE_URL=/api.
# VITE variables are build-time public values, never put secrets in them.
